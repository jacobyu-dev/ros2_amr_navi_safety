<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mission_manager</name>
  <version>0.1.0</version>
  <description>Phase 13 C++ NavigateToPose integration with safety-aware mission control.</description>
  <maintainer email="jacob-dev@example.com">jacob-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>arm_navi_safety_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>lidar_safety</exec_depend>
  <exec_depend>safety_supervisor</exec_depend>
  <exec_depend>safety_test_tools</exec_depend>
  <exec_depend>sensor_watchdog</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf_monitor</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
