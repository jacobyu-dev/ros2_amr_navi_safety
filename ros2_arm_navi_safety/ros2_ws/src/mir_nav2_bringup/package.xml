<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mir_nav2_bringup</name>
  <version>0.1.0</version>
  <description>Production Nav2 bringup for the local MiR Gazebo worlds and safety stack.</description>
  <maintainer email="jacob-dev@example.com">jacob-dev</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amr_simulation</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lidar_safety</exec_depend>
  <exec_depend>mission_manager</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_path_validator</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>safety_supervisor</exec_depend>
  <exec_depend>sensor_watchdog</exec_depend>
  <exec_depend>tf_monitor</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
