<?xml version="1.0" ?>
<!--
  Collision-aware local warehouse worker.

  The former Gazebo <actor> was visual-only: it had no link, inertia, or
  collision geometry. This model deliberately keeps visual and collision
  geometry on the same physics body so LiDAR, Nav2, and Gazebo all observe the
  same moving object.

  simulation.launch.py moves each instance between two world waypoints. This
  model stays static in the physics solver, making it a solid kinematic obstacle
  rather than a visual-only actor.
-->
<sdf version="1.9">
  <model name="warehouse_worker">
    <static>true</static>
    <link name="body">
      <inertial>
        <pose>0 0 0.85 0 0 0</pose>
        <mass>70.0</mass>
        <inertia>
          <ixx>18.23</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>18.23</iyy>
          <iyz>0.0</iyz>
          <izz>2.744</izz>
        </inertia>
      </inertial>

      <!-- One continuous body gives both physics and LiDAR a robust target. -->
      <collision name="worker_collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.28</radius>
            <length>1.70</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Local primitive visuals avoid a network-only Fuel dependency. -->
      <visual name="left_leg">
        <pose>0 0.10 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.80</length></cylinder></geometry>
        <material><diffuse>0.10 0.13 0.20 1</diffuse></material>
      </visual>
      <visual name="right_leg">
        <pose>0 -0.10 0.45 0 0 0</pose>
        <geometry><cylinder><radius>0.09</radius><length>0.80</length></cylinder></geometry>
        <material><diffuse>0.10 0.13 0.20 1</diffuse></material>
      </visual>
      <visual name="torso">
        <pose>0 0 1.18 0 0 0</pose>
        <geometry><box><size>0.30 0.46 0.72</size></box></geometry>
        <material><diffuse>0.95 0.45 0.05 1</diffuse></material>
      </visual>
      <visual name="head">
        <pose>0 0 1.70 0 0 0</pose>
        <geometry><sphere><radius>0.18</radius></sphere></geometry>
        <material><diffuse>0.72 0.50 0.35 1</diffuse></material>
      </visual>
      <visual name="safety_vest">
        <pose>-0.156 0 1.20 0 0 0</pose>
        <geometry><box><size>0.015 0.48 0.38</size></box></geometry>
        <material>
          <diffuse>0.95 0.85 0.05 1</diffuse>
          <emissive>0.10 0.08 0.0 1</emissive>
        </material>
      </visual>
    </link>

  </model>
</sdf>
