<?xml version="1.0"?>
<!-- Self-contained Gazebo Harmonic warehouse.  All geometry is local so the
     world remains available offline. -->
<sdf version="1.9">
  <world name="amr_warehouse">
    <physics name="physics" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <gui>
      <camera name="warehouse_overview">
        <pose>0 -18 14 0 0.72 1.57</pose>
      </camera>
    </gui>
    <scene><ambient>0.62 0.62 0.62 1</ambient><background>0.78 0.78 0.78 1</background><shadows>false</shadows></scene>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>

    <model name="ground_plane"><static>true</static><link name="ground_link"><collision name="ground_collision"><geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry></collision><visual name="ground_visual"><geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual></link></model>

    <!-- 18 m by 14 m collision enclosure. -->
    <model name="north_wall"><static>true</static><pose>0 7 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>18 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.2 2.5</size></box></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -7 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>18 0.2 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>18 0.2 2.5</size></box></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>9 0 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 14 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 14 2.5</size></box></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-9 0 1.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.2 14 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.2 14 2.5</size></box></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual></link></model>

    <!-- Blue storage racks, arranged in two rows around the driving aisle. -->
    <model name="rack_1"><static>true</static><pose>-5.5 2.8 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 1 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 1 1.5</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>
    <model name="rack_2"><static>true</static><pose>0 2.8 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 1 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 1 1.5</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>
    <model name="rack_3"><static>true</static><pose>5.5 2.8 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 1 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 1 1.5</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>
    <model name="rack_4"><static>true</static><pose>-5.5 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 1 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 1 1.5</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>
    <model name="rack_5"><static>true</static><pose>0 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 1 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 1 1.5</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>
    <model name="rack_6"><static>true</static><pose>5.5 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4 1 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4 1 1.5</size></box></geometry><material><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>

    <model name="box_obstacle_1"><static>true</static><pose>-2.5 -5 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><diffuse>0.65 0.35 0.1 1</diffuse></material></visual></link></model>
    <model name="box_obstacle_2"><static>true</static><pose>3.5 -4.5 0.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1 1 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1 1 1</size></box></geometry><material><diffuse>0.65 0.35 0.1 1</diffuse></material></visual></link></model>
    <model name="box_obstacle_3"><static>true</static><pose>7 0 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 1.2 1.2</size></box></geometry><material><diffuse>0.65 0.35 0.1 1</diffuse></material></visual></link></model>
  </world>
</sdf>
