<?xml version="1.0"?>
<!-- Local detailed warehouse, designed for Gazebo Harmonic without Fuel. -->
<sdf version="1.9">
  <world name="amr_warehouse_detailed">
    <physics name="physics" type="ignored"><max_step_size>.01</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <gui><camera name="warehouse_overview"><pose>0 -23 22 0 .78 1.57</pose></camera></gui>
    <scene><ambient>.55 .55 .55 1</ambient><background>.75 .75 .75 1</background><shadows>true</shadows><grid>false</grid></scene>
    <light name="sun" type="directional"><pose>0 0 12 0 0 0</pose><diffuse>.85 .85 .85 1</diffuse><direction>-.3 .2 -1</direction></light>

    <model name="warehouse_shell"><static>true</static><link name="structure">
      <collision name="floor"><pose>0 0 -.1 0 0 0</pose><geometry><box><size>30 20 .2</size></box></geometry></collision>
      <collision name="north"><pose>0 10 2 0 0 0</pose><geometry><box><size>30 .3 4</size></box></geometry></collision><collision name="south"><pose>0 -10 2 0 0 0</pose><geometry><box><size>30 .3 4</size></box></geometry></collision>
      <collision name="east"><pose>15 0 2 0 0 0</pose><geometry><box><size>.3 20 4</size></box></geometry></collision><collision name="west"><pose>-15 0 2 0 0 0</pose><geometry><box><size>.3 20 4</size></box></geometry></collision>
      <visual name="floor"><pose>0 0 -.1 0 0 0</pose><geometry><box><size>30 20 .2</size></box></geometry><material><diffuse>.52 .50 .45 1</diffuse></material></visual>
      <visual name="north"><pose>0 10 2 0 0 0</pose><geometry><box><size>30 .3 4</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual><visual name="south"><pose>0 -10 2 0 0 0</pose><geometry><box><size>30 .3 4</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual>
      <visual name="east"><pose>15 0 2 0 0 0</pose><geometry><box><size>.3 20 4</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual><visual name="west"><pose>-15 0 2 0 0 0</pose><geometry><box><size>.3 20 4</size></box></geometry><material><diffuse>.16 .17 .18 1</diffuse></material></visual>
    </link></model>

    <!-- Two shipping aisles; each rack has local shelf and carton geometry. -->
    <include><uri>model://pallet_rack</uri><name>rack_left_1</name><pose>-9 5 0 0 0 1.5708</pose></include><include><uri>model://pallet_rack</uri><name>rack_left_2</name><pose>-9 0 0 0 0 1.5708</pose></include><include><uri>model://pallet_rack</uri><name>rack_left_3</name><pose>-9 -5 0 0 0 1.5708</pose></include>
    <include><uri>model://pallet_rack</uri><name>rack_center_1</name><pose>-2 5 0 0 0 0</pose></include><include><uri>model://pallet_rack</uri><name>rack_center_2</name><pose>-2 1.5 0 0 0 0</pose></include><include><uri>model://pallet_rack</uri><name>rack_center_3</name><pose>-2 -2 0 0 0 0</pose></include>
    <include><uri>model://pallet_rack</uri><name>rack_right_1</name><pose>7 5 0 0 0 0</pose></include><include><uri>model://pallet_rack</uri><name>rack_right_2</name><pose>7 1.5 0 0 0 0</pose></include><include><uri>model://pallet_rack</uri><name>rack_right_3</name><pose>7 -2 0 0 0 0</pose></include>
    <include><uri>model://pallet_rack</uri><name>rack_right_4</name><pose>7 -5.5 0 0 0 0</pose></include>

    <model name="loading_bay"><static>true</static><pose>1 -7.5 .4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>5 2 .8</size></box></geometry></collision><visual name="visual"><geometry><box><size>5 2 .8</size></box></geometry><material><diffuse>.28 .30 .30 1</diffuse></material></visual></link></model>
  </world>
</sdf>
