<?xml version="1.0" ?>
<!-- Adapted, self-contained layout based on the Apache-2.0 Bookstore world.
     AWS Robomaker Fuel models are intentionally not redistributed. -->
<sdf version="1.9"><world name="amr_bookstore">
  <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
  <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><direction>-0.4 0.2 -0.9</direction></light>
  <model name="floor"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>30 24</size></plane></geometry><material><diffuse>0.45 0.38 0.28 1</diffuse></material></visual></link></model>
  <model name="north_wall"><static>true</static><pose>0 11 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>30 .2 3</size></box></geometry></collision><visual name="v"><geometry><box><size>30 .2 3</size></box></geometry></visual></link></model><model name="south_wall"><static>true</static><pose>0 -11 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>30 .2 3</size></box></geometry></collision><visual name="v"><geometry><box><size>30 .2 3</size></box></geometry></visual></link></model>
  <model name="west_wall"><static>true</static><pose>-15 0 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>.2 22 3</size></box></geometry></collision><visual name="v"><geometry><box><size>.2 22 3</size></box></geometry></visual></link></model><model name="east_wall"><static>true</static><pose>15 0 1.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>.2 22 3</size></box></geometry></collision><visual name="v"><geometry><box><size>.2 22 3</size></box></geometry></visual></link></model>
  <!-- parallel shelf rows keep 1.4 m aisles for a MiR100 -->
  <model name="shelf_row_1"><static>true</static><pose>-8 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1 17 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1 17 2</size></box></geometry><material><diffuse>.35 .16 .05 1</diffuse></material></visual></link></model><model name="shelf_row_2"><static>true</static><pose>-4 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1 17 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1 17 2</size></box></geometry><material><diffuse>.35 .16 .05 1</diffuse></material></visual></link></model><model name="shelf_row_3"><static>true</static><pose>0 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1 17 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1 17 2</size></box></geometry><material><diffuse>.35 .16 .05 1</diffuse></material></visual></link></model><model name="shelf_row_4"><static>true</static><pose>4 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1 17 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1 17 2</size></box></geometry><material><diffuse>.35 .16 .05 1</diffuse></material></visual></link></model><model name="shelf_row_5"><static>true</static><pose>8 0 1 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1 17 2</size></box></geometry></collision><visual name="v"><geometry><box><size>1 17 2</size></box></geometry><material><diffuse>.35 .16 .05 1</diffuse></material></visual></link></model>
</world></sdf>
