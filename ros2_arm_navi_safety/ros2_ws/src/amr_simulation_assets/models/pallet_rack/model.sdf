<?xml version="1.0"?>
<!-- Reusable local pallet rack: orange frame, yellow decks, and cartons. -->
<sdf version="1.9">
  <model name="pallet_rack">
    <static>true</static>
    <link name="frame">
      <collision name="left_front"><pose>-2 -0.62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry></collision>
      <collision name="left_back"><pose>-2 .62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry></collision>
      <collision name="right_front"><pose>2 -0.62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry></collision>
      <collision name="right_back"><pose>2 .62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry></collision>
      <collision name="deck_low"><pose>0 0 .35 0 0 0</pose><geometry><box><size>4.1 1.25 .10</size></box></geometry></collision>
      <collision name="deck_mid"><pose>0 0 1.2 0 0 0</pose><geometry><box><size>4.1 1.25 .10</size></box></geometry></collision>
      <collision name="deck_top"><pose>0 0 2.05 0 0 0</pose><geometry><box><size>4.1 1.25 .10</size></box></geometry></collision>
      <visual name="left_front"><pose>-2 -0.62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry><material><diffuse>.75 .25 .05 1</diffuse></material></visual>
      <visual name="left_back"><pose>-2 .62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry><material><diffuse>.75 .25 .05 1</diffuse></material></visual>
      <visual name="right_front"><pose>2 -0.62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry><material><diffuse>.75 .25 .05 1</diffuse></material></visual>
      <visual name="right_back"><pose>2 .62 1.3 0 0 0</pose><geometry><box><size>.12 .12 2.6</size></box></geometry><material><diffuse>.75 .25 .05 1</diffuse></material></visual>
      <visual name="deck_low"><pose>0 0 .35 0 0 0</pose><geometry><box><size>4.1 1.25 .10</size></box></geometry><material><diffuse>.86 .66 .08 1</diffuse></material></visual>
      <visual name="deck_mid"><pose>0 0 1.2 0 0 0</pose><geometry><box><size>4.1 1.25 .10</size></box></geometry><material><diffuse>.86 .66 .08 1</diffuse></material></visual>
      <visual name="deck_top"><pose>0 0 2.05 0 0 0</pose><geometry><box><size>4.1 1.25 .10</size></box></geometry><material><diffuse>.86 .66 .08 1</diffuse></material></visual>
    </link>
    <link name="cartons">
      <visual name="carton_1"><pose>-1.15 0 .68 0 0 0</pose><geometry><box><size>1.45 1.0 .58</size></box></geometry><material><diffuse>.72 .54 .16 1</diffuse></material></visual>
      <visual name="carton_2"><pose>.85 0 .68 0 0 0</pose><geometry><box><size>1.45 1.0 .58</size></box></geometry><material><diffuse>.72 .54 .16 1</diffuse></material></visual>
      <visual name="carton_3"><pose>-1.15 0 1.53 0 0 0</pose><geometry><box><size>1.45 1.0 .58</size></box></geometry><material><diffuse>.72 .54 .16 1</diffuse></material></visual>
      <visual name="carton_4"><pose>.85 0 1.53 0 0 0</pose><geometry><box><size>1.45 1.0 .58</size></box></geometry><material><diffuse>.72 .54 .16 1</diffuse></material></visual>
      <visual name="carton_5"><pose>-1.15 0 2.38 0 0 0</pose><geometry><box><size>1.45 1.0 .58</size></box></geometry><material><diffuse>.72 .54 .16 1</diffuse></material></visual>
      <visual name="carton_6"><pose>.85 0 2.38 0 0 0</pose><geometry><box><size>1.45 1.0 .58</size></box></geometry><material><diffuse>.72 .54 .16 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
